      "parameters": {
        "jsCode": "// 1. Get current lead data\n// We use the specific syntax you found to be sure we get the loop item\nconst lead = $('Loop Over Items').item.json;\n\n// 2. Get the config (Trigger Node)\nconst config = $('When Executed by Another Workflow').first().json;\n\nlet body = config.email_body || \"\";\nlet subject = config.email_subject || \"\";\nlet senderName = config.email_sender_Name || \"Moazzam\";\n\n// 3. Replacements\nconst replacements = {\n  \"{{business_name}}\": lead[\"Business Name\"] || \"there\",\n  \"{{address}}\": lead[\"Address\"] || \"\",\n  \"{{phone}}\": lead[\"Phone\"] || \"\",\n  \"{{website}}\": lead[\"Website\"] || \"\",\n  \"{{rating}}\": lead[\"Rating\"] || \"\",\n  \"{{review_count}}\": lead[\"Review Count\"] || \"0\",\n  \"{{sender_name}}\": senderName\n};\n\n// 4. Execute Replacement\nfor (const [placeholder, value] of Object.entries(replacements)) {\n  const escapedPlaceholder = placeholder.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  const regex = new RegExp(escapedPlaceholder, 'g');\n  body = body.replace(regex, value);\n  subject = subject.replace(regex, value);\n}\n\n// 5. Return\nreturn {\n  json: {\n    ...lead,\n    final_email_body: body,\n    final_email_subject: subject,\n    sender_email: config.sender_email_id,\n    sender_name: senderName\n  }\n};"
      },
