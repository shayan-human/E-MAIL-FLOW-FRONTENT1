INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('d650bed0-cc74-4fd4-a473-c95886863c28', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V3', 'quick question about your ceramic coating page, {{firstName}}', 'Hey {{firstName}},\n\nTook a look at your site. Your work is solid but the ceramic coating page isn''t doing it justice.\n\nI put together a sample page for detailing shops that actually gets people to book. Reviews up front, pricing visible, one tap to get in touch.\n\nWorth sending it over?\nDemGrow', '2026-03-21 06:16:20.033538+00', '2026-03-21 06:16:20.033538+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('60fb4c13-14ad-49d2-ab9f-ebb498e9e74e', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V4', '{{firstName}} – made something for your shop', 'Hey {{firstName}},\n\nI build sites for detailing shops and put together a sample ceramic coating page I wanted to show you.\n\nHeadline, service breakdown, customer reviews, booking button. Took a couple hours to build and I think it''d work well for a shop like yours.\n\nWant to see it?\n\nbest , \nDemGrow', '2026-03-21 06:18:12.105161+00', '2026-03-21 06:18:12.105161+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('0065dc95-25b2-4a38-b41d-4d4413a39d55', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V5', 'ceramic coating page for {{firstName}}', 'Hey {{firstName}},\n\nBuilt a sample website page for detailing shops that do ceramic coating. Clean layout, reviews section, booking button.\n\nWant to take a look?\n\nBest,\nDemGrow', '2026-03-21 06:20:37.022101+00', '2026-03-21 06:20:37.022101+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('d123cc6c-c097-44a9-9488-b910797255aa', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V6', 'how some detailers nearby are picking up more bookings', 'Hi {{firstName}},\n\nA few shops I''ve worked with recently started getting more inbound after we fixed how their ceramic coating page was laid out. Mostly just getting reviews and the booking path in the right spots.\n\nI have a sample of that. Thought it might be worth showing you.\n\nGood to send it over?\n\nBest,\nDemGrow', '2026-03-21 06:21:51.106495+00', '2026-03-21 06:21:51.106495+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('15437a7c-f657-4dcf-938c-995ff74040bc', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V7', 'most detailing sites lose the customer before they ever call', 'Hi {{firstName}},\n\nA lot of detailing shop sites have the same issue. Someone lands on the page, can''t find pricing, can''t find reviews, and just leaves.\n\nCeramic coating is a big ticket service. People do their research. I put together a page layout that handles all of that properly.\n\nCan I send it your way?\n\nBest,\nDemGrow', '2026-03-21 06:23:42.158742+00', '2026-03-21 06:23:42.158742+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('8063274a-4add-4a9f-a4e8-02989be6bc10', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V8', 'your work is good, {{firstName}} – the site should say that', 'Hey {{firstName}},\n\nCame across your shop and your work looks great. The website just doesn''t reflect that yet.\n\nI built a sample ceramic coating page with the kind of layout that actually builds trust before someone picks up the phone. Thought it might be relevant.\n\nShould I send it over?\n\nBest,\nDemGrow', '2026-03-21 06:24:47.051486+00', '2026-03-21 06:24:47.051486+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('b0dff03d-70c7-40fa-9e81-cf0c3cbd857f', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V9', 'one page change and a detailer went from calls only to online bookings', 'Hi {{firstName}},\n\nA shop I helped a while back was getting all their business through word of mouth. After we rebuilt their ceramic coating page, online bookings started coming in regularly.\n\nThe difference was mostly layout. Reviews up top, clear service breakdown, one button.\n\nI put a sample together. Want to see it?\n\nBest,\nDemGrow', '2026-03-21 06:25:48.012705+00', '2026-03-21 06:25:48.012705+00', NULL) ON CONFLICT DO NOTHING;
INSERT INTO public.drafts (id, user_id, name, subject, body, created_at, updated_at, folder_id) VALUES ('780808ec-3794-46ec-8b3e-016399624360', '9c70d838-994a-452a-b6b7-1476f98d893e', 'V10', 'can I show you something for your shop, {{firstName}}?', 'Hey {{firstName}},\n\nNot going to pitch you on anything today. Just want to show you a page layout I put together for a ceramic coating service and see if it makes sense for your shop.\n\nIf it''s a fit, great. If not, no worries.\n\nWorth a look?\n\nBest, \nDemGrow', '2026-03-21 06:29:06.72213+00', '2026-03-21 06:29:06.72213+00', NULL) ON CONFLICT DO NOTHING;
