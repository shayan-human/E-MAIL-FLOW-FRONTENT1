{
  "name": "Verify Sender Credential",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "verify-sender",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-verify-sender",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 0],
      "webhookId": "verify-sender"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "limit": 1
      },
      "id": "gmail-verify",
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [200, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "={{ $json.body.credential_id }}"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": true,\n  \"email\": \"{{ $('Webhook').item.json.body.email }}\",\n  \"credential_id\": \"{{ $('Webhook').item.json.body.credential_id }}\"\n}",
        "options": {}
      },
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [400, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
